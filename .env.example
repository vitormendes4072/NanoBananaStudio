# ─── Required ────────────────────────────────────────────────────────────────

# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# ─── Optional ────────────────────────────────────────────────────────────────

# Port the Express server listens on (default: 3000)
PORT=3000

# Number of parallel generation workers, 1–5 (default: 2)
QUEUE_CONCURRENCY=2

# Path to the SQLite database file (default: data/database.sqlite)
DATABASE_PATH=data/database.sqlite

# SQLite journal mode — WAL recommended for concurrent reads (default: WAL)
DATABASE_JOURNAL_MODE=WAL

# Maximum items retained per collection — oldest deleted when exceeded, with a warning toast
MAX_JOBS=200
MAX_CUTOUTS=100
MAX_CROPS=100

# Pricing for cost estimation (USD per generated image).
# Google does not expose a real-time pricing API — update here when prices change.
# Reference: https://ai.google.dev/pricing
PRICE_GEMINI_FLASH_IMAGE=0.039
PRICE_GEMINI_PRO_IMAGE=0.134

# ISO date (YYYY-MM-DD) displayed to the user as "tabela atualizada em" — bump when you update prices
PRICING_UPDATED_AT=2026-05-28
