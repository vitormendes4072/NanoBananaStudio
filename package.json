{
  "name": "nano-banana-studio",
  "version": "1.0.0",
  "description": "Studio local de geracao e edicao de imagens com a API do Gemini",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev:server": "node --watch server.js",
    "dev:ui": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "vite build",
    "test:smoke": "node tests/smoke.test.mjs",
    "lint": "eslint server/ src/ server.js",
    "lint:fix": "eslint --fix server/ src/ server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.0.0",
    "@imgly/background-removal": "^1.7.0",
    "@imgly/background-removal-node": "^1.4.5",
    "archiver": "^5.3.2",
    "better-sqlite3": "^12.9.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "vite": "^8.0.11"
  }
}
